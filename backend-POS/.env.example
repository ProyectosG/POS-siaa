# Copia este archivo como .env y llena los valores. El .env nunca se sube a git.

# Puerto del servidor
PORT=5000

# Ruta del archivo SQLite (relativa a backend-POS o absoluta).
# Si se deja vacía se usa src/pos.db
DB_PATH=./src/pos.db

# Secreto para firmar los tokens JWT. Usa una cadena larga y aleatoria, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Origen(es) permitidos por CORS (la URL del frontend). Varios separados por coma.
CORS_ORIGIN=http://localhost:3000

# SuperDeveloper. Si alguna de las dos queda vacía, el SuperDeveloper está apagado.
SUPERDEV_USER=
SUPERDEV_PASSWORD=

# (Opcional) Solo si el servidor está detrás de un proxy (Render, nginx...): cuántos
# proxies hay delante, para que el límite de intentos de clave vea la IP real de
# cada equipo. En la tienda, sin proxy, se deja comentado.
# TRUST_PROXY=1

# (Opcional) Carpeta de respaldos (reset y migraciones). Por omisión: backend-POS/backups
# BACKUP_DIR=./backups

# (Opcional) Zona horaria del negocio: el servidor pone fecha y hora de cada movimiento.
# Por omisión: America/Mexico_City
# TZ_NEGOCIO=America/Mexico_City

# (Opcional) Modo demo: SOLO en el servicio de la demo pública, nunca en la tienda.
# Con MODO_DEMO=1 la base se BORRA y se vuelve a sembrar en cada arranque (DB_PATH
# debe terminar en demo.db) y lo sensible responde 403. Ver docs/DEMO-RENDER.md.
# MODO_DEMO=1
